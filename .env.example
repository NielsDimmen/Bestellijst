# SQLite path is relative to prisma/schema.prisma → project ./data/bestellijst.db
DATABASE_URL="file:../data/bestellijst.db"

# Secret for sessions / app security
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: password for seeded admin (username: admin).
# If unset, seed generates one and prints it to the console.
ADMIN_PASSWORD=""

# Optional: catering phone for WhatsApp deeplink (wa.me).
# Seeded as Setting cateringPhone; also used as fallback if admin setting is empty.
# Dutch local numbers like 06… are normalized to 316…
CATERING_PHONE=""
